# Avvio automatico sul Raspberry: la bici funziona senza portatile.
# Installazione (repo clonato in /home/utente/hackTurin, venv con ultralytics in /home/utente/gs):
#   echo <IP della UNO Q> > /home/utente/hackTurin/pi/casco_ip.txt   # cambia a ogni riconnessione all'hotspot
#   sudo cp guardaspalle.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now guardaspalle
#   journalctl -u guardaspalle -f        # per vedere i messaggi
# Dopo aver cambiato casco_ip.txt: sudo systemctl restart guardaspalle
[Unit]
Description=Guardaspalle - percezione posteriore
After=network-online.target
Wants=network-online.target

[Service]
User=utente
WorkingDirectory=/home/utente/hackTurin/pi
ExecStart=/home/utente/gs/bin/python -u bike_adas.py --source 0 --us-trig 23 --us-echo 24 --us-side B --clips --stream
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
